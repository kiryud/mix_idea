# Copy this file to .env, then change values as needed for your local machine.
# `scripts/start-local.ps1 -UseDocker` starts the bundled MySQL on port 3307.
DB_HOST=jdbc:mysql://127.0.0.1:3307/idea_support?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=idea_support
DB_PASSWORD=local-db-password
MYSQL_ROOT_PASSWORD=local-root-password
MYSQL_PORT=3307

# Keep mock mode for an offline/local demo. Gemini mode requires a valid key.
AI_MODE=mock
GEMINI_API_KEY=
AI_MODEL=
AI_IDEA_TIMEOUT_SECONDS=5
AI_RECIPE_TIMEOUT_SECONDS=20
AI_MATCH_TIMEOUT_SECONDS=15
AI_MAX_CONCURRENT=4

# Local-only development values. Replace all three with unique secrets before deployment.
JWT_SECRET=aWRlYS1zdXBwb3J0LWxvY2FsLWRlbW8ta2V5LTAwMDE=
SHA_KEY=idea-support-local-sha
AES_KEY=local-demo-aes-key-32-characters

SERVER_PUBLIC_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8081,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
